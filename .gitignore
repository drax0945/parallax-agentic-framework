.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.env

# Parallax runtime state: caches, trained models, run transcripts, audit log.
#
# The whole directory, not the four paths that exist today. Listing them
# individually meant anything a later version wrote beside them — a session
# file, a cached credential — would have been visible to `git add -A`.
# Nothing under here is source: it all rebuilds or re-downloads.
.parallax/

# Workspace data — the lab's, not the repo's.
#
# `logbook/` holds real experiments and `memory/` holds what the agent concluded
# from them. Both are specific to whoever is running Parallax, and neither is
# something a clone should inherit: a shipped logbook entry would be read as
# in-house precedent by somebody else's agent, which is exactly wrong.
#
# `reports/` is the same: generated output from whatever was run here.
#
# `parallax init` creates all three, and the stores create their own on first
# use, so a fresh clone starts with an empty workspace rather than a broken one.
# To commit one report deliberately: git add -f reports/<name>.html
#
# This also keeps test and demo runs out of the repository.
logbook/
memory/
reports/

# Credentials, belt and braces. Nothing here should ever be written into the
# repo, and none of it is today — these patterns exist so that a future slip
# is caught by git rather than by a reader of the published history.
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc
.npmrc
.claude/.credentials.json
.claude/settings.local.json

# IDE
.idea/
.vscode/
.DS_Store

